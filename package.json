{
    "name": "coldspa",
    "version": "0.3.0",
    "description": "Give your CFML a spa day. The Islands Architecture for ColdFusion.",
    "type": "module",
    "license": "MIT",
    "author": "crutchcorn",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/crutchcorn/coldspa.git"
    },
    "homepage": "https://github.com/crutchcorn/coldspa#readme",
    "bugs": {
        "url": "https://github.com/crutchcorn/coldspa/issues"
    },
    "keywords": [
        "coldfusion",
        "cfml",
        "islands",
        "islands-architecture",
        "vite",
        "vite-plugin",
        "vue",
        "react",
        "ssr",
        "hydration"
    ],
    "exports": {
        ".": "./coldspa/vite/plugin.js",
        "./vite": "./coldspa/vite/plugin.js",
        "./vite/ssr-server": "./coldspa/vite/ssr-server.js",
        "./package.json": "./package.json"
    },
    "main": "./coldspa/vite/plugin.js",
    "bin": {
        "coldspa-ssr": "./coldspa/vite/ssr-server.js"
    },
    "files": [
        "coldspa/**/*.js",
        "docs/**",
        "media/**",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "vite",
        "vite:vue": "vite --config vite.config.vue.js",
        "vite:react": "vite --config vite.config.react.js",
        "ssr": "node coldspa/vite/ssr-server.js",
        "ssr:prod": "cross-env NODE_ENV=production node coldspa/vite/ssr-server.js",
        "build": "vite build && cross-env COLDSPA_SSR=1 vite build",
        "build:client": "vite build",
        "build:ssr": "cross-env COLDSPA_SSR=1 vite build",
        "website:dev": "cd website && astro dev",
        "website:build": "cd website && astro build"
    },
    "peerDependencies": {
        "@vitejs/plugin-react": "^4.0.0",
        "@vitejs/plugin-vue": "^5.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "vite": "^5.0.0 || ^6.0.0",
        "vue": "^3.4.0"
    },
    "peerDependenciesMeta": {
        "@vitejs/plugin-react": { "optional": true },
        "@vitejs/plugin-vue":   { "optional": true },
        "react":                { "optional": true },
        "react-dom":            { "optional": true },
        "vue":                  { "optional": true }
    },
    "devDependencies": {
        "@astrojs/starlight": "^0.38.4",
        "@vitejs/plugin-react": "^4.3.4",
        "@vitejs/plugin-vue": "^5.0.0",
        "astro": "^6.1.9",
        "cross-env": "^7.0.3",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "sharp": "^0.34.5",
        "vite": "^5.0.0",
        "vue": "^3.4.0"
    }
}

